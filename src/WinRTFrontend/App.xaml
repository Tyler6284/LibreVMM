<Application
    x:Class="LibreVMM.WinRT.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:LibreVMM.WinRT">
    
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Default.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            
            <!-- Ubuntu Aubergine Theme Colors -->
            <SolidColorBrush x:Key="AubergineDarkBrush" Color="#2c001e"/>
            <SolidColorBrush x:Key="AubergineLightBrush" Color="#5e2750"/>
            <SolidColorBrush x:Key="AubergineMidBrush" Color="#77216f"/>
            <SolidColorBrush x:Key="OrangeLightBrush" Color="#fb8456"/>
            <SolidColorBrush x:Key="OrangeMidBrush" Color="#e95420"/>
            <SolidColorBrush x:Key="OrangeDarkBrush" Color="#c74726"/>
            <SolidColorBrush x:Key="BackgroundLightBrush" Color="#ffffff"/>
            <SolidColorBrush x:Key="BackgroundDarkBrush" Color="#1a1a1a"/>
            <SolidColorBrush x:Key="TextOnDarkBrush" Color="#ffffff"/>
            <SolidColorBrush x:Key="TextOnLightBrush" Color="#333333"/>
            <SolidColorBrush x:Key="GrayPanelBrush" Color="#e8e8e8"/>
            <SolidColorBrush x:Key="GrayBorderBrush" Color="#d0d0d0"/>
            
            <!-- Default Button Style -->
            <Style x:Key="PrimaryButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource OrangeMidBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource TextOnDarkBrush}"/>
                <Setter Property="Padding" Value="16,8"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
            </Style>
            
            <Style x:Key="SecondaryButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{StaticResource TextOnLightBrush}"/>
                <Setter Property="Padding" Value="16,8"/>
                <Setter Property="BorderBrush" Value="{StaticResource GrayBorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
            </Style>
            
            <!-- Page Styles -->
            <Style x:Key="PageStyle" TargetType="Page">
                <Setter Property="Background" Value="{StaticResource BackgroundLightBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource TextOnLightBrush}"/>
            </Style>
            
        </ResourceDictionary>
    </Application.Resources>
</Application>
