<!--
  @file MainPage.xaml
  @brief Main Page for WinRT Frontend
  
  Basic VM management UI for UWP / Windows Mobile.
  Scope: VM creation wizard, basic device configuration, 
  start/stop/pause, display output, snapshot list.
  
  SPDX-License-Identifier: GPL-3.0-or-later
  SPDX-FileCopyrightText: Copyright (C) 2024 LibreVMM Contributors
-->

<Page
    x:Class="LibreVMM.WinRT.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:LibreVMM.WinRT"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Header / App Bar -->
        <Grid Grid.Row="0" Background="{StaticResource AubergineDarkBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <!-- App Title -->
            <TextBlock Grid.Column="0" 
                       Text="LibreVMM" 
                       FontSize="24" 
                       FontWeight="Bold"
                       Foreground="White"
                       Margin="16,12"/>
            
            <!-- Action Buttons -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="8">
                <Button x:Name="RefreshButton" 
                        Content="Refresh" 
                        Click="RefreshButton_Click"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Margin="4"/>
                <Button x:Name="NewVMButton" 
                        Content="New VM" 
                        Click="NewVMButton_Click"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Margin="4"/>
            </StackPanel>
        </Grid>
        
        <!-- Main Content -->
        <Grid Grid.Row="1" Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <!-- VM List Panel -->
            <Border Grid.Column="0" 
                    BorderBrush="{StaticResource GrayBorderBrush}" 
                    BorderThickness="1" 
                    CornerRadius="4"
                    Margin="0,0,8,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <TextBlock Grid.Row="0" 
                               Text="Virtual Machines" 
                               FontSize="18" 
                               FontWeight="SemiBold"
                               Margin="12,8"/>
                    
                    <ListView x:Name="VMListView" 
                              Grid.Row="1"
                              SelectionMode="Single"
                              SelectionChanged="VMListView_SelectionChanged">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="8,4">
                                    <TextBlock Text="{Binding Name}" 
                                               FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding State}" 
                                               Foreground="Gray"
                                               FontSize="12"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>
            
            <!-- VM Details Panel -->
            <Border Grid.Column="1" 
                    BorderBrush="{StaticResource GrayBorderBrush}" 
                    BorderThickness="1" 
                    CornerRadius="4"
                    Margin="8,0,0,0">
                <ScrollViewer>
                    <StackPanel x:Name="DetailsPanel" Margin="16" Visibility="Collapsed">
                        <!-- VM Name -->
                        <TextBlock x:Name="VMNameText" 
                                   FontSize="24" 
                                   FontWeight="Bold"
                                   Margin="0,0,0,8"/>
                        
                        <!-- Status -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <Ellipse x:Name="StatusIndicator" 
                                     Width="12" 
                                     Height="12" 
                                     Fill="Gray"
                                     Margin="0,0,8,0"/>
                            <TextBlock x:Name="VMStateText" 
                                       Text="Powered Off"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        
                        <!-- VM Info -->
                        <TextBlock Text="Configuration" 
                                   FontSize="16" 
                                   FontWeight="SemiBold"
                                   Margin="0,8"/>
                        
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="OS Type:" Foreground="Gray"/>
                            <TextBlock x:Name="OSTypeText" Grid.Row="0" Grid.Column="1" Text="-" Margin="0,0,0,4"/>
                            
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Memory:" Foreground="Gray"/>
                            <TextBlock x:Name="MemoryText" Grid.Row="1" Grid.Column="1" Text="-" Margin="0,0,0,4"/>
                            
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="CPUs:" Foreground="Gray"/>
                            <TextBlock x:Name="CPUCountText" Grid.Row="2" Grid.Column="1" Text="-" Margin="0,0,0,4"/>
                            
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="VRAM:" Foreground="Gray"/>
                            <TextBlock x:Name="VRAMText" Grid.Row="3" Grid.Column="1" Text="-" Margin="0,0,0,4"/>
                        </Grid>
                        
                        <!-- Action Buttons -->
                        <StackPanel Orientation="Horizontal" Margin="0,24,0,0">
                            <Button x:Name="StartButton" 
                                    Content="Start" 
                                    Click="StartButton_Click"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Margin="0,0,8,0"/>
                            <Button x:Name="PauseButton" 
                                    Content="Pause" 
                                    Click="PauseButton_Click"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Margin="0,0,8,0"
                                    IsEnabled="False"/>
                            <Button x:Name="StopButton" 
                                    Content="Stop" 
                                    Click="StopButton_Click"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Margin="0,0,8,0"
                                    IsEnabled="False"/>
                            <Button x:Name="SettingsButton" 
                                    Content="Settings" 
                                    Click="SettingsButton_Click"
                                    Style="{StaticResource SecondaryButtonStyle}"/>
                        </StackPanel>
                        
                        <!-- Snapshots Section -->
                        <TextBlock Text="Snapshots" 
                                   FontSize="16" 
                                   FontWeight="SemiBold"
                                   Margin="0,24,0,8"/>
                        
                        <Button x:Name="TakeSnapshotButton" 
                                Content="Take Snapshot" 
                                Click="TakeSnapshotButton_Click"
                                Style="{StaticResource SecondaryButtonStyle}"
                                HorizontalAlignment="Left"/>
                        
                        <ListView x:Name="SnapshotsListView" 
                                  Margin="0,8,0,0"
                                  MaxHeight="200">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="4">
                                        <TextBlock Text="{Binding Name}"/>
                                        <TextBlock Text="{Binding TimeStamp}" 
                                                   FontSize="11" 
                                                   Foreground="Gray"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
        
        <!-- Status Bar -->
        <Border Grid.Row="2" 
                Background="{StaticResource AubergineDarkBrush}" 
                Padding="16,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <TextBlock x:Name="StatusText" 
                           Text="Ready" 
                           Foreground="White"
                           VerticalAlignment="Center"/>
                
                <TextBlock x:Name="VMCountText" 
                           Grid.Column="1"
                           Text="0 VMs" 
                           Foreground="White"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Page>
